#!/usr/bin/env python3
"""Block agent tool calls that would print a secret.

One guard for every coding agent on this machine:
  secret-guard claude   Claude Code PreToolUse hook. Reads the hook JSON on stdin.
  secret-guard bash     Reads a shell command on stdin (used by the Pi extension).
  secret-guard path     Reads a file path on stdin (used by the Pi extension).

Exit 0 allows the call. Exit 2 blocks it, with the reason on stderr.
This is a guardrail against accidents, not a sandbox. The user can still run
anything with `!` in Claude Code or the user-bash prompt in Pi.
"""

from __future__ import annotations

import json
import os
import re
import sys

HOME = os.path.expanduser("~")
H = r"(?:~|\$HOME|\$\{HOME\}|" + re.escape(HOME) + r")"

# Files that hold secrets. Keep this list in sync with permissions.deny in
# ~/.claude/settings.json and with the laptop setup prompt.
SECRET_PATHS = [
    H + r"/\.zshenv\b",
    H + r"/\.git-credentials\b",
    H + r"/\.netrc\b",
    H + r"/\.aws/credentials\b",
    H + r"/\.config/glab-cli/",
    H + r"/\.config/secrets/",
    H + r"/\.claude/\.credentials\.json\b",
    H + r"/\.codeaf/config\.json",
    H + r"/\.pi/agent/auth\.json",
    H + r"/\.pi/agent/models\.json",
    H + r"/\.ssh/id_[^\s/.]+(?!\.pub)\b",
    r"/proc/(?:\d+|self|\$\w+|\$\{\w+\}|\*)/environ\b",
    # Personal shell secrets in the dotfiles repo, but not the .example template.
    r"\.?zsh_secrets(?!\.example\b)\b",
    # .env files, but not .env.example, .env.sample, or .env.template.
    r"(?:^|[\s/'\"=])\.env(?!\.(?:example|sample|template)\b)(?:\.[\w-]+)?(?=$|[\s'\";|&)<>])",
]
SECRET_RE = re.compile("|".join(SECRET_PATHS))

# Bare-name forms, for paths given relative to the right folder.
BARE_SECRET_RE = re.compile(
    r"(?:^|[\s'\"/])(?:\.zshenv|\.git-credentials|\.netrc|credentials\.json|auth\.json)(?=$|[\s'\";|&)])"
)

# Commands that only touch metadata or move bytes without printing them.
SAFE_SEGMENT_RE = re.compile(
    r"^\s*(?:sudo\s+)?(?:ls|stat|test|\[|file|chmod|chown|touch|mkdir|cp|mv|ln|systemctl|"
    r"sha256sum|md5sum|wc\s+-[lc])\b"
)

SECRET_VAR = r"\$\{?[A-Za-z_]*(?:KEY|TOKEN|SECRET|PASSW(?:OR)?D|CREDENTIAL|AUTH)[A-Za-z_]*\}?"
ENV_DUMP_RES = [
    re.compile(r"(?:^|[;&|(]\s*)(?:env|printenv|export\s+-p|declare\s+-[px]|set)\s*(?:$|[;&|)])"),
    re.compile(r"(?:^|[;&|(]\s*)printenv\s+\S*(?:KEY|TOKEN|SECRET|PASS|CREDENTIAL|AUTH)", re.I),
    re.compile(r"(?:^|[;&|(]\s*)(?:echo|printf)\b[^|;&]*" + SECRET_VAR),
    re.compile(r"\b(?:gh|glab)\s+auth\s+(?:token|status\b[^|;&]*(?:-t\b|--show-token))"),
    re.compile(r"\bsecurity\s+find-(?:generic|internet)-password\b[^|;&]*\s-w\b"),
    re.compile(r"\bsecret-tool\s+lookup\b"),
    re.compile(r"\bpass\s+(?:show\s+)?[\w./-]+\s*(?:$|[;&|])"),
    re.compile(r"\baws\s+configure\s+(?:get|export-credentials)\b"),
    re.compile(r"\bgit\s+credential\s+fill\b"),
]
# A secret piped into a hash or a counter is not printed.
HASHED_RE = re.compile(r"\|\s*(?:sha256sum|sha1sum|md5sum|wc\b|grep\s+-c\b)")

REASON = (
    "secret-guard: blocked because this command could print a secret "
    "(a key, token, or password file, or a secret environment variable). "
    "Select only the non-secret fields you need, or compare a sha256 prefix. "
    "If the user needs the raw value, ask them to run the command themselves."
)


def _segments(command: str) -> list[str]:
    return [s for s in re.split(r"\|\||&&|[;|\n]", command) if s.strip()]


def bash_blocked(command: str) -> bool:
    if any(r.search(command) for r in ENV_DUMP_RES) and not HASHED_RE.search(command):
        return True
    for seg in _segments(command):
        if (SECRET_RE.search(seg) or BARE_SECRET_RE.search(seg)) and not SAFE_SEGMENT_RE.search(seg):
            return True
    return False


def path_blocked(path: str) -> bool:
    p = os.path.expanduser(path.strip())
    return bool(SECRET_RE.search(p) or SECRET_RE.search(" " + p) or BARE_SECRET_RE.search(" " + os.path.basename(p)))


def _block() -> int:
    print(REASON, file=sys.stderr)
    return 2


def main() -> int:
    mode = sys.argv[1] if len(sys.argv) > 1 else ""
    data = sys.stdin.read()
    if mode == "bash":
        return _block() if bash_blocked(data) else 0
    if mode == "path":
        return _block() if path_blocked(data) else 0
    if mode == "claude":
        try:
            event = json.loads(data)
        except json.JSONDecodeError:
            return 0
        tool = event.get("tool_name", "")
        tin = event.get("tool_input") or {}
        if tool == "Bash" and bash_blocked(tin.get("command", "")):
            return _block()
        if tool in ("Read", "Edit", "Write", "NotebookEdit"):
            if path_blocked(tin.get("file_path", "") or tin.get("notebook_path", "")):
                return _block()
        if tool in ("Grep", "Glob") and tin.get("path") and path_blocked(tin["path"]):
            return _block()
        return 0
    print("usage: secret-guard claude|bash|path", file=sys.stderr)
    return 0


if __name__ == "__main__":
    sys.exit(main())
