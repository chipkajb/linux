#!/usr/bin/env bash
# i3-monitors — switch the display layout between saved monitor profiles.
#
#   i3-monitors                 pick a profile with rofi
#   i3-monitors list            list profiles (marks the active one)
#   i3-monitors status          active profile + connected outputs
#   i3-monitors <profile>       apply a profile (xrandr + regenerate i3 include)
#   i3-monitors auto            detect and apply the matching profile
#   i3-monitors apply           re-apply the active profile's xrandr only
#   i3-monitors generate <p>    regenerate the i3 include without touching X
#
# Profiles live in config/i3/monitors/<name>.sh and define semantic roles
# (left/middle/right/bottom). config/i3/config includes the generated
# ~/.i3_monitors, so workspaces — and therefore apps — follow the same roles in
# every setup.
#
# Env:
#   I3_MONITORS_NO_RESTART=1   skip `i3-msg restart` (useful in scripts/tests)

set -euo pipefail

SELF="$(readlink -f "${BASH_SOURCE[0]}")"
REPO_ROOT="$(cd "$(dirname "$SELF")/.." && pwd)"
# shellcheck source=../lib/log.sh
. "$REPO_ROOT/lib/log.sh"
# shellcheck source=../lib/common.sh
. "$REPO_ROOT/lib/common.sh"

MONITORS_DIR="$REPO_ROOT/config/i3/monitors"
STATE_DIR="$HOME/.config/i3-monitors"
PROFILE_FILE="$STATE_DIR/current"
INCLUDE="$HOME/.i3_monitors"
ROFI_CONFIG="$HOME/.config/rofi/config.rasi"

# Prefer multi-monitor setups when several profiles match the connected outputs.
PROFILE_ORDER=(office home laptop)

usage() {
    cat <<'EOF'
Switch the display layout between saved monitor profiles.

  i3-monitors                 pick a profile with rofi
  i3-monitors list            list profiles (marks the active one)
  i3-monitors status          active profile + connected outputs
  i3-monitors <profile>       apply a profile (xrandr + regenerate i3 include)
  i3-monitors auto            detect and apply the matching profile
  i3-monitors apply           re-apply the active profile's xrandr only
  i3-monitors generate <p>    regenerate the i3 include without touching X
  i3-monitors detect          print the profile matching the connected outputs

Profiles live in config/i3/monitors/<name>.sh and define semantic roles
(left/middle/right/bottom). config/i3/config includes the generated
~/.i3_monitors, so workspaces follow the same roles in every setup.

Env:
  I3_MONITORS_NO_RESTART=1   skip `i3-msg restart` (useful in scripts/tests)
EOF
}

list_profile_names() {
    local file
    for file in "$MONITORS_DIR"/*.sh; do
        [[ -e "$file" ]] || continue
        basename "$file" .sh
    done
}

load_profile() {
    local name="$1"
    local file="$MONITORS_DIR/$name.sh"
    if [[ ! -f "$file" ]]; then
        ui::err "unknown monitor profile: $name"
        ui::hint "available: $(list_profile_names | tr '\n' ' ')"
        return 1
    fi
    unset PROFILE_LABEL OUTPUT_LEFT OUTPUT_MIDDLE OUTPUT_RIGHT OUTPUT_BOTTOM XRANDR_ARGS
    # shellcheck source=/dev/null
    . "$file"
}

current_profile() {
    if [[ -f "$PROFILE_FILE" ]]; then
        cat "$PROFILE_FILE"
    fi
}

connected_outputs() {
    xrandr --query 2>/dev/null | awk '/ connected/{print $1}'
}

# Outputs a profile actually enables (everything not immediately followed by --off).
profile_active_outputs() {
    local i=0
    while ((i < ${#XRANDR_ARGS[@]})); do
        if [[ "${XRANDR_ARGS[i]}" == "--output" ]]; then
            local name="${XRANDR_ARGS[i + 1]}" j=$((i + 2)) active=1
            while ((j < ${#XRANDR_ARGS[@]})) && [[ "${XRANDR_ARGS[j]}" != "--output" ]]; do
                [[ "${XRANDR_ARGS[j]}" == "--off" ]] && active=0
                ((j++))
            done
            ((active)) && printf '%s\n' "$name"
            i=$j
        else
            ((i++))
        fi
    done
}

# Echo the first profile whose enabled outputs are all connected.
detect_profile() {
    local connected name
    connected="$(connected_outputs)"
    for name in "${PROFILE_ORDER[@]}"; do
        [[ -f "$MONITORS_DIR/$name.sh" ]] || continue
        local -a outputs=()
        mapfile -t outputs < <(
            ( load_profile "$name" >/dev/null 2>&1; profile_active_outputs )
        )
        ((${#outputs[@]})) || continue
        local output matched=1
        for output in "${outputs[@]}"; do
            if ! grep -qx "$output" <<<"$connected"; then
                matched=0
                break
            fi
        done
        ((matched)) && {
            printf '%s\n' "$name"
            return 0
        }
    done
    return 1
}

# Writes the i3 include and records the active profile. Returns 0 when the
# include changed, 1 when it was already up to date (used to decide on restart).
generate_include() {
    local name="$1"
    load_profile "$name"
    ensure_dir "$STATE_DIR"

    local tmp
    tmp="$(mktemp)"
    cat >"$tmp" <<EOF
# Generated by i3-monitors — do not edit by hand.
# Profile: ${name} (${PROFILE_LABEL})
set \$monitor_left ${OUTPUT_LEFT}
set \$monitor_middle ${OUTPUT_MIDDLE}
set \$monitor_right ${OUTPUT_RIGHT}
set \$monitor_bottom ${OUTPUT_BOTTOM}
EOF

    printf '%s\n' "$name" >"$PROFILE_FILE"

    if [[ -f "$INCLUDE" ]] && cmp -s "$tmp" "$INCLUDE"; then
        rm -f "$tmp"
        return 1
    fi
    mv "$tmp" "$INCLUDE"
    return 0
}

i3_restart_if_running() {
    [[ -n "${I3_MONITORS_NO_RESTART:-}" ]] && return 0
    have i3-msg || return 0
    [[ -n "${DISPLAY:-}" ]] || return 0
    i3-msg -t get_version >/dev/null 2>&1 || return 0
    i3-msg restart >/dev/null
}

apply_xrandr() {
    xrandr "${XRANDR_ARGS[@]}"
}

switch_profile() {
    local name="$1" changed=0
    load_profile "$name"
    ui::header "Monitor profile · ${PROFILE_LABEL}"
    ui::kv "left" "$OUTPUT_LEFT"
    ui::kv "middle" "$OUTPUT_MIDDLE"
    ui::kv "right" "$OUTPUT_RIGHT"
    ui::kv "bottom" "$OUTPUT_BOTTOM"

    apply_xrandr
    if generate_include "$name"; then
        changed=1
    fi
    ui::done "layout applied"
    if ((changed)); then
        i3_restart_if_running
    fi
}

cmd_list() {
    local current name label
    current="$(current_profile)"
    for name in $(list_profile_names); do
        load_profile "$name"
        label="$PROFILE_LABEL"
        if [[ "$name" == "$current" ]]; then
            printf '  %s %s\n' "$(ui::green '*')" "$(ui::bold "$name") $(ui::gray "— $label")"
        else
            printf '    %s %s\n' "$name" "$(ui::gray "— $label")"
        fi
    done
}

cmd_status() {
    local current
    current="$(current_profile)"
    ui::header "Monitors"
    if [[ -n "$current" ]]; then
        load_profile "$current" && ui::kv "profile" "$current ($PROFILE_LABEL)"
    else
        ui::kv "profile" "$(ui::yellow 'none set')"
    fi
    ui::kv "include" "$INCLUDE"
    printf '\n  %s\n' "$(ui::purple 'connected outputs')"
    connected_outputs | sed 's/^/    /'
}

cmd_picker() {
    local current name label choice
    current="$(current_profile)"
    local -a lines=()
    for name in $(list_profile_names); do
        load_profile "$name"
        label="$PROFILE_LABEL"
        [[ "$name" == "$current" ]] && label="$label  (active)"
        lines+=("$name  —  $label")
    done

    if ! have rofi; then
        ui::err "rofi not found; run: i3-monitors <profile>"
        return 1
    fi
    choice="$(printf '%s\n' "${lines[@]}" | rofi -dmenu -i -p "Monitor profile" -config "$ROFI_CONFIG" -lines 6)"
    [[ -n "${choice:-}" ]] || return 0
    switch_profile "${choice%% *}"
}

cmd_auto() {
    local detected
    if ! detected="$(detect_profile)"; then
        ui::warn "no monitor profile matches the connected outputs"
        ui::hint "connected: $(connected_outputs | tr '\n' ' ')"
        return 0
    fi
    if [[ "$detected" == "$(current_profile)" ]]; then
        # profile unchanged — re-apply geometry (handles monitor hotplug), no restart
        load_profile "$detected"
        apply_xrandr
        return 0
    fi
    switch_profile "$detected"
}

main() {
    local cmd="${1:-picker}"
    case "$cmd" in
        -h | --help | help)
            usage
            ;;
        list)
            cmd_list
            ;;
        status)
            cmd_status
            ;;
        auto)
            cmd_auto
            ;;
        detect)
            detect_profile || true
            ;;
        apply)
            local current
            current="$(current_profile)"
            [[ -n "$current" ]] || current="$(detect_profile || printf 'office')"
            load_profile "$current"
            apply_xrandr
            ui::ok "applied $current"
            ;;
        generate)
            [[ -n "${2:-}" ]] || {
                ui::err "generate requires a profile name"
                return 1
            }
            if generate_include "$2"; then
                ui::ok "wrote $INCLUDE ($2)"
            else
                ui::info "$INCLUDE already up to date ($2)"
            fi
            ;;
        picker | "")
            cmd_picker
            ;;
        *)
            switch_profile "$cmd"
            ;;
    esac
}

main "$@"
