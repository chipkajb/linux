#!/usr/bin/env bash
# open flameshot on the monitor under the mouse for crop + annotate

set -euo pipefail

require_cmd() {
    if ! command -v "$1" >/dev/null 2>&1; then
        printf 'i3-flameshot-screen: install %s\n' "$1" >&2
        exit 1
    fi
}

require_cmd xdotool
require_cmd flameshot
require_cmd xrandr

eval "$(xdotool getmouselocation --shell)"

region=""
while IFS= read -r line; do
    if [[ "$line" =~ connected.*([0-9]+)x([0-9]+)\+([0-9]+)\+([0-9]+) ]]; then
        w="${BASH_REMATCH[1]}"
        h="${BASH_REMATCH[2]}"
        mx="${BASH_REMATCH[3]}"
        my="${BASH_REMATCH[4]}"
        if (( X >= mx && X < mx + w && Y >= my && Y < my + h )); then
            region="${w}x${h}+${mx}+${my}"
            break
        fi
    fi
done < <(xrandr --current)

if [[ -z "$region" ]]; then
    exec flameshot gui
fi

exec flameshot gui --region "$region"
