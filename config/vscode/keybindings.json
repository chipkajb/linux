// Place your key bindings in this file to override the defaults
[
  {
    "key": "ctrl+shift+j",
    "command": "workbench.action.focusActiveEditorGroup",
    "when": ""
  },
  {
    "key": "ctrl+shift+k",
    "command": "workbench.action.terminal.focus",
    "when": ""
  },
  {
    "key": "ctrl+shift+h",
    "command": "workbench.debug.action.focusRepl",
    "when": ""
  },
  {
    "key": "ctrl+shift+h",
    "command": "-workbench.action.replaceInFiles"
  },
  {
    "key": "ctrl+shift+`",
    "command": "workbench.debug.action.focusRepl",
    "when": "editorTextFocus || terminalFocus"
  },
  {
    "key": "ctrl+shift+l",
    "command": "workbench.action.moveActiveEditorGroupDown"
  },

  // Sidebar shortcuts
  {
    "key": "ctrl+shift+b",
    "command": "workbench.action.toggleSidebarVisibility"
  },
  {
    "key": "ctrl+shift+g",
    "command": "workbench.view.scm"
  },

  // Vim shortcuts
  {
    "key": "shift+j",
    "command": "editor.action.moveLinesDownAction",
    "when": "editorTextFocus && !editorReadonly && vim.active && (vim.mode == 'Visual' || vim.mode == 'VisualLine' || vim.mode == 'VisualBlock')"
  },
  {
    "key": "shift+k",
    "command": "editor.action.moveLinesUpAction",
    "when": "editorTextFocus && !editorReadonly && vim.active && (vim.mode == 'Visual' || vim.mode == 'VisualLine' || vim.mode == 'VisualBlock')"
  },

  // Tab navigation
  {
    "key": "ctrl+tab",
    "command": "workbench.action.nextEditorInGroup",
    "when": "editorTextFocus"
  },
  {
    "key": "ctrl+shift+tab",
    "command": "workbench.action.previousEditorInGroup",
    "when": "editorTextFocus"
  },

  // Git shortcuts — stage/revert selected ranges (editor focused, peek closed)
  {
    "key": "shift+alt+s",
    "command": "git.stageSelectedRanges",
    "when": "editorTextFocus && !dirtyDiffVisible && !isInDiffEditor"
  },
  {
    "key": "shift+alt+r",
    "command": "git.revertSelectedRanges",
    "when": "editorTextFocus && !dirtyDiffVisible && !isInDiffEditor"
  },
  // Same keys in side-by-side diff editor (highlighted ranges)
  {
    "key": "shift+alt+s",
    "command": "git.stageSelectedRanges",
    "when": "isInDiffEditor && isInDiffRightEditor && editorTextFocus"
  },
  {
    "key": "shift+alt+r",
    "command": "git.revertSelectedRanges",
    "when": "isInDiffEditor && isInDiffRightEditor && editorTextFocus"
  },
  // Inline git diff peek — hunk at cursor (peek may hold focus, not the editor)
  {
    "key": "shift+alt+s",
    "command": "git.diff.stageHunk",
    "when": "dirtyDiffVisible"
  },
  {
    "key": "shift+alt+r",
    "command": "git.revertSelectedRanges",
    "when": "dirtyDiffVisible"
  },
  // Peek open but editor still has a selection — prefer selected ranges over cursor hunk
  {
    "key": "shift+alt+s",
    "command": "git.stageSelectedRanges",
    "when": "dirtyDiffVisible && editorTextFocus && editorHasSelection"
  },
  {
    "key": "shift+alt+r",
    "command": "git.revertSelectedRanges",
    "when": "dirtyDiffVisible && editorTextFocus && editorHasSelection"
  },
  {
    "key": "shift+alt+d",
    "command": "gitlens.diffWithPrevious",
    "when": "editorTextFocus"
  },
  {
    "key": "shift+alt+u",
    "command": "git.unstageSelectedRanges",
    "when": "editorTextFocus"
  },

  // Git diff navigation — inline peek at next/previous unstaged hunk (requires Index diffs hidden; see settings.json git comment)
  {
    "key": "shift+alt+]",
    "command": "editor.action.dirtydiff.next",
    "when": "editorTextFocus && !isInDiffEditor"
  },
  {
    "key": "shift+alt+[",
    "command": "editor.action.dirtydiff.previous",
    "when": "editorTextFocus && !isInDiffEditor"
  },
  // Jump to next gutter change without opening the peek (blue=modified, green=added, red=deleted)
  {
    "key": "shift+alt+.",
    "command": "workbench.action.editor.nextChange",
    "when": "editorTextFocus && !isInDiffEditor"
  },
  // Same hunk navigation in the side-by-side diff editor
  {
    "key": "shift+alt+]",
    "command": "workbench.action.compareEditor.nextChange",
    "when": "isInDiffEditor"
  },
  {
    "key": "shift+alt+[",
    "command": "workbench.action.compareEditor.previousChange",
    "when": "isInDiffEditor"
  },
  {
    "key": "shift+alt+.",
    "command": "workbench.action.compareEditor.nextChange",
    "when": "isInDiffEditor"
  },
  {
    "key": "escape",
    "command": "closeQuickDiff",
    "when": "dirtyDiffVisible"
  },

  // Disable ctrl+e shortcut while in terminal
  {
    "key": "ctrl+e",
    "command": "workbench.action.quickOpen",
    "when": "editorTextFocus"
  },
  {
    "key": "ctrl+e",
    "command": "-workbench.action.quickOpen"
  },

  // Save without formatting
  {
    "key": "ctrl+shift+s",
    "command": "workbench.action.files.saveWithoutFormatting"
  },

  // Terminal
  {
    "key": "ctrl+l",
    "command": "workbench.action.terminal.clear",
    "when": "terminalFocus"
  },
  {
    "key": "ctrl+shift+t",
    "command": "workbench.action.toggleMaximizedPanel",
    "when": "terminalFocus"
  },
  {
    "key": "ctrl+r",
    "command": "null",
    "when": "terminalFocus"
  },
  {
    "key": "ctrl+r",
    "command": "-workbench.action.quickOpen",
    "when": "terminalFocus"
  },

  // Cursor
  {
    "key": "ctrl+i",
    "command": "-inlineChat.start",
    "when": "editorFocus && inlineChatHasProvider && !editorReadonly"
  },
  {
    "key": "ctrl+i",
    "command": "-composer.startComposerPrompt",
    "when": "composerIsEnabled"
  },
  {
    "key": "ctrl+shift+l",
    "command": "-aichat.insertselectionintochat"
  },
  {
    "key": "ctrl+i",
    "command": "composerMode.agent"
  },
  {
    "key": "ctrl+l",
    "command": "composerMode.chat"
  },
  {
    "key": "shift+enter",
    "command": "-python.execInREPL",
    "when": "config.python.REPL.sendToNativeREPL && editorTextFocus && !isCompositeNotebook && !jupyter.ownsSelection && !notebookEditorFocused && editorLangId == 'python'"
  },
  {
    "key": "shift+enter",
    "command": "-python.execSelectionInTerminal",
    "when": "editorTextFocus && !findInputFocussed && !isCompositeNotebook && !jupyter.ownsSelection && !notebookEditorFocused && !replaceInputFocussed && editorLangId == 'python'"
  },
  {
    "key": "ctrl+alt+s",
    "command": "workbench.action.toggleUnifiedSidebarFromKeyboard",
    "when": "cursor.agentIdeUnification.enabled == true && !isAuxiliaryWindowFocusedContext"
  }
]
