/* rofi — launcher, window switcher, and dmenu backend.
 *
 * One palette (Gruvbox dark, matching config/i3/config, config/dunst/dunstrc
 * and config/alacritty) and no decoration: a raised card, a recessed input
 * row, and a flat list. Colour is used for the prompt and for urgency only.
 *
 * The palette is inlined rather than imported so this file is the only place
 * that needs editing to re-theme rofi.
 */

configuration {
    font:                 "System San Francisco Display 14";
    show-icons:           true;
    icon-theme:           "Yaru-blue-dark";
    display-drun:         "Apps";
    drun-display-format:  "{name}";
    scroll-method:        0;
    disable-history:      false;
    sidebar-mode:         false;
    run-command:          "env GTK_THEME=Yaru-blue-dark:dark {cmd}";
    drun-command:         "env GTK_THEME=Yaru-blue-dark:dark {cmd}";
}

/* rofi ships a built-in theme whose light row backgrounds win over a bare
 * `element` rule, because `element.normal.normal` is the more specific
 * selector. Every state/type pair therefore has to be spelled out below, or
 * the list falls back to rofi's cream rows. */

* {
    bg:             #1d2021;
    bg-alt:         #282828;
    bg-raised:      #3c3836;
    fg:             #ebdbb2;
    fg-muted:       #a89984;
    fg-dim:         #7c6f64;
    accent:         #d79921;
    danger:         #fb4934;
    danger-bg:      #3c2020;

    background-color: transparent;
    text-color:       @fg;
    border-color:     @bg-raised;
    separatorcolor:   @bg-raised;
    spacing:          0;
}

window {
    /* Opaque on purpose. rofi's window is override-redirect, and picom does not
     * blur those, so a translucent card would just show a sharp background
     * through it — muddy rather than frosted. */
    background-color: @bg;
    border:           1px;
    border-color:     @bg-raised;
    border-radius:    12px;
    padding:          12px;
    width:            620px;
    location:         center;
    y-offset:         -14%;
    children:         [ inputbar, listview ];
}

inputbar {
    children:         [ prompt, entry ];
    background-color: @bg-alt;
    border-radius:    8px;
    padding:          8px 12px;
    spacing:          8px;
}

prompt {
    text-color:       @accent;
    padding:          0;
}

entry {
    text-color:         @fg;
    placeholder:        "Search…";
    placeholder-color:  @fg-dim;
}

listview {
    lines:            10;
    columns:          1;
    fixed-height:     true;
    border:           0;
    background-color: transparent;
    padding:          10px 0 0 0;
    spacing:          2px;
    scrollbar:        false;
    cycle:            true;
}

/* Geometry shared by every row state. */
element {
    padding:       8px 10px;
    spacing:       10px;
    border:        0;
    border-radius: 8px;
}

element-icon {
    size:             1.2em;
    background-color: transparent;
}

element-text {
    background-color: transparent;
    text-color:       inherit;
    vertical-align:   0.5;
}

/* Unselected rows: no fill at all, so the window colour shows through. */
element.normal.normal,
element.alternate.normal {
    background-color: transparent;
    text-color:       @fg;
}

/* Selected row: raised chip. No border, so it does not double up with the
 * window border. */
element.selected.normal {
    background-color: @bg-raised;
    text-color:       @fg;
}

element.normal.active,
element.alternate.active {
    background-color: transparent;
    text-color:       @accent;
}

element.selected.active {
    background-color: @bg-raised;
    text-color:       @accent;
}

element.normal.urgent,
element.alternate.urgent {
    background-color: transparent;
    text-color:       @danger;
}

element.selected.urgent {
    background-color: @danger-bg;
    text-color:       @danger;
}

message {
    background-color: @danger-bg;
    text-color:       @fg;
    border-radius:    8px;
    padding:          8px;
    margin:           10px 0 0 0;
}

error-message {
    background-color: @danger-bg;
    text-color:       @fg;
    border-radius:    8px;
    padding:          8px;
}
