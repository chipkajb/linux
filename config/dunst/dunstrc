# See dunst(5) for all configuration options
# Gruvbox theme aligned with i3 / alacritty

[global]
    ### Display ###

    monitor = 0
    follow = keyboard

    ### Geometry ###

    width = 360
    height = (0, 120)
    origin = top-right
    offset = 20x20
    scale = 0
    notification_limit = 12

    ### Progress bar ###

    progress_bar = true
    progress_bar_height = 6
    progress_bar_frame_width = 0
    progress_bar_min_width = 120
    progress_bar_max_width = 280
    progress_bar_corner_radius = 3

    icon_corner_radius = 8

    indicate_hidden = yes
    shrink = yes
    transparency = 12

    separator_height = 0
    padding = 14
    horizontal_padding = 16
    text_icon_padding = 14

    frame_width = 2
    frame_color = "#3c3836"
    gap_size = 6

    separator_color = frame
    sort = yes
    idle_threshold = 120

    ### Text ###

    font = pango:System San Francisco Display 12
    line_height = 4
    markup = full
    format = "<b><span color='#fabd2f'>%s</span></b>\n<span color='#d5c4a1'>%b</span>"
    alignment = left
    vertical_alignment = top
    show_age_threshold = 45
    word_wrap = yes
    ellipsize = end
    ignore_newline = yes
    stack_duplicates = true
    hide_duplicate_count = true
    show_indicators = no

    ### Icons ###

    enable_recursive_icon_lookup = true
    # Yaru-blue-dark inherits Yaru/Humanity; hicolor holds local app icons (slack, herdr, …)
    icon_theme = Yaru-blue-dark,Yaru,hicolor
    icon_position = left
    min_icon_size = 32
    max_icon_size = 48
    # legacy path search (used when recursive lookup misses a name)
    icon_path = /usr/share/icons/Yaru/48x48/status/:/usr/share/icons/Yaru/48x48/apps/:/usr/share/pixmaps/

    ### History ###

    sticky_history = yes
    history_length = 30

    ### Misc ###

    dmenu = /usr/bin/dmenu -p dunst:
    browser = /usr/bin/xdg-open
    always_run_script = true
    title = Dunst
    class = Dunst
    corner_radius = 14
    ignore_dbusclose = false
    force_xwayland = false
    force_xinerama = false

    mouse_left_click = do_action
    mouse_middle_click = close_current
    mouse_right_click = close_all

[experimental]
    per_monitor_dpi = false

[urgency_low]
    background = "#32302f"
    foreground = "#a89984"
    frame_color = "#504945"
    timeout = 6
    # blue "i" — used only when the app sends no icon
    default_icon = /usr/share/icons/Yaru/48x48/status/dialog-information.png

[urgency_normal]
    background = "#282828"
    foreground = "#ebdbb2"
    frame_color = "#458588"
    timeout = 8
    default_icon = /usr/share/icons/Yaru/48x48/status/dialog-information.png

[urgency_critical]
    background = "#3c2020"
    foreground = "#fbf1c7"
    frame_color = "#fb4934"
    timeout = 0
    # red / warning mark for critical
    default_icon = /usr/share/icons/Yaru/48x48/status/dialog-error.png

[shortcuts]
    close = mod1+r
    close_all = mod1+space
    history = mod1+u

# --- App icons (default_icon keeps any icon the app already sent, e.g. avatars) ---

[i3-feedback]
    appname = i3
    history_ignore = yes

[slack]
    appname = Slack
    new_icon = ~/.local/share/icons/hicolor/48x48/apps/slack.png

[cursor]
    appname = Cursor
    default_icon = /usr/share/pixmaps/co.anysphere.cursor.png

[claude]
    appname = Claude
    default_icon = /usr/share/icons/hicolor/48x48/apps/claude-desktop.png

[claude-desktop]
    appname = claude-desktop
    default_icon = /usr/share/icons/hicolor/48x48/apps/claude-desktop.png

[herdr]
    appname = Herdr
    new_icon = ~/.local/share/icons/hicolor/48x48/apps/herdr.png

[google-chrome]
    appname = "Google Chrome"
    default_icon = google-chrome

# Upgrade libnotify's tiny Humanity fallbacks to crisp 48px Yaru icons
[fallback-information]
    icon = "*dialog-information*"
    new_icon = /usr/share/icons/Yaru/48x48/status/dialog-information.png

[fallback-warning]
    icon = "*dialog-warning*"
    new_icon = /usr/share/icons/Yaru/48x48/status/dialog-warning.png

[fallback-error]
    icon = "*dialog-error*"
    new_icon = /usr/share/icons/Yaru/48x48/status/dialog-error.png

# Slack snap sends empty appname + generic info icon. Summaries look like:
#   [workspace] from Name
#   [workspace] in channel-or-#channel
[slack-from]
    summary = "[[]*] from *"
    new_icon = ~/.local/share/icons/hicolor/48x48/apps/slack.png

[slack-in]
    summary = "[[]*] in *"
    new_icon = ~/.local/share/icons/hicolor/48x48/apps/slack.png

# stack volume changes
[stack-volume]
    desktop_entry = "*"
    match_transient = no
    category = "x-volumed"
    set_stack_tag = "volume"
    timeout = 3

# strip empty lines and cap summary/body length before display
[sanitize-all]
    summary = *
    category = !x-sanitized
    format = ""
    script = ~/.config/dunst/sanitize-notification.sh

# preserve line breaks from sanitize-notification.sh (global ignore_newline=yes collapses them)
[sanitize-display]
    category = "x-sanitized"
    ignore_newline = no

# vim: ft=cfg
