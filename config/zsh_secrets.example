# Template for ~/.zsh_secrets, which config/zshrc sources if it exists.
# Copy to ~/.zsh_secrets, fill in real values, and chmod 600. Never commit the filled copy.
#
#   cp config/zsh_secrets.example ~/.zsh_secrets && chmod 600 ~/.zsh_secrets

# Fireworks API key. Used by:
#   - the `ai` helper (bin/ai): shell ghost text and `ai commit-msg`
#   - Neovim: minuet inline completion and next-edit prediction
#   - config/nvim/custom/configs/ai.lua picks minuet as the backend when this is set
#
# export FIREWORKS_API_KEY=""
