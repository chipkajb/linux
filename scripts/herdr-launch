#!/usr/bin/env bash
# launch herdr (for rofi / .desktop / i3)

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
mkdir -p "$HOME/.local/bin"
# Herdr calls bare `notify-send` with no icon; wrap it so client toasts
# use the Herdr logo. Non-herdr callers pass through unchanged.
ln -sfn "$SCRIPT_DIR/herdr-notify-send" "$HOME/.local/bin/notify-send"
chmod +x "$SCRIPT_DIR/herdr-notify-send"

export PATH="$HOME/.local/bin:$PATH"

if ! command -v herdr >/dev/null 2>&1; then
    printf 'herdr not found. Install with: curl -fsSL https://herdr.dev/install.sh | sh\n' >&2
    exit 1
fi

exec herdr "$@"
