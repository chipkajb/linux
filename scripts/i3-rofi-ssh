#!/usr/bin/env bash
# pick an ssh host from ~/.ssh/config and attach with herdr --remote

set -euo pipefail

rofi_config="${HOME}/.config/rofi/config.rasi"
ssh_config="${HOME}/.ssh/config"

list_hosts() {
    if [[ ! -f "$ssh_config" ]]; then
        return 0
    fi

    awk '
        /^[Hh]ost[ \t]+/ {
            for (i = 2; i <= NF; i++) {
                if ($i !~ /[*?]/) {
                    print $i
                }
            }
        }
    ' "$ssh_config" | sort -u
}

notify() {
    if [[ -x /usr/bin/notify-send ]]; then
        /usr/bin/notify-send -a i3 "$@"
    fi
}

if ! command -v herdr >/dev/null 2>&1; then
    notify "Herdr" "herdr not found — install with: curl -fsSL https://herdr.dev/install.sh | sh"
    exit 1
fi

hosts="$(list_hosts)"
if [[ -z "$hosts" ]]; then
    notify "Herdr remote" "No hosts found in ~/.ssh/config"
    exit 0
fi

host="$(printf '%s\n' "$hosts" | rofi -dmenu -i -p "herdr --remote" -config "$rofi_config" -lines 12)"
[[ -n "${host:-}" ]] || exit 0

# --remote defaults to --remote-keybindings local, which replaces the server's profile
# with this machine's and drops every [[keys.command]] on the way. Ask for the server's
# profile so the remote's config.toml drives the prefix and the custom commands.
exec herdr --remote-keybindings server --remote "$host"
