#!/usr/bin/env bash
# launch jmux with bun on PATH (for rofi / .desktop / i3)

set -euo pipefail

export BUN_INSTALL="${BUN_INSTALL:-$HOME/.bun}"
export PATH="$BUN_INSTALL/bin:$HOME/.local/bin:$PATH"

if ! command -v jmux >/dev/null 2>&1; then
    printf 'jmux not found. Install with: bun install -g @jx0/jmux\n' >&2
    exit 1
fi

exec jmux "$@"
