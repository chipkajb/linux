#!/usr/bin/env bash
# toggle dunst quiet mode and show a status notification

set -euo pipefail

command -v dunstctl >/dev/null 2>&1 || exit 0

QUIET_DELAY="${QUIET_DELAY:-3}"

notify() {
    if [[ -x /usr/bin/notify-send ]]; then
        /usr/bin/notify-send -a i3 "$@"
    elif command -v notify-send >/dev/null 2>&1; then
        notify-send -a i3 "$@"
    fi
}

paused="$(dunstctl is-paused 2>/dev/null || echo false)"

if [[ "$paused" == "true" ]]; then
    dunstctl set-paused false
    notify "Quiet mode" "Off — notifications resumed" -i dialog-information
else
    notify "Quiet mode" "On — notifications paused" -i dialog-information -t "$((QUIET_DELAY * 1000))"
    sleep "$QUIET_DELAY"
    dunstctl set-paused true
fi
